set -e

# Redirect any output to the journal (stderr)
exec 1>&2

# If the control reaches this step, the service can be enabled and started

touch smarthost.env

systemctl --user enable --now matomo.service
# List every unit: restarting the pod alone returns before its children run
systemctl --user restart matomo.service matomo-mariadb.service matomo-app.service
systemctl --user enable --now matomo-archive.timer