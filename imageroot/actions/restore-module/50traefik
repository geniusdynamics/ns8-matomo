# Re-create the Traefik route from the settings copied by 06copyenv. The
# environment is used instead of request['environment'] because this step is
# linked into clone-module too, whose request has no environment.

import sys
import agent
import os

host = os.environ.get("TRAEFIK_HOST", "")
if not host:
    print(agent.SD_NOTICE + "no host name in the original settings: configure the module from the UI", file=sys.stderr)
    sys.exit(0)

configure_retval = agent.tasks.run(agent_id=os.environ['AGENT_ID'], action='configure-module', data={
    "lets_encrypt": os.environ.get("TRAEFIK_LETS_ENCRYPT", "True") == "True",
    "host": host,
    "http2https": os.environ.get("TRAEFIK_HTTP2HTTPS", "True") == "True",
})
agent.assert_exp(configure_retval['exit_code'] == 0, "The configure-module subtask failed!")
