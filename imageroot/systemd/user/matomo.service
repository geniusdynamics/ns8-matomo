#
# This systemd unit starts the matomo pod using Podman.
# Most parts of this file come from podman-generate-systemd.
# slirp4netns with allow_host_loopback: the app reaches the ldapproxy of a
# user domain on the node loopback as 10.0.2.2.
#

[Unit]
Description=Podman matomo.service
Requires=matomo-mariadb.service matomo-app.service
Before=matomo-mariadb.service matomo-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%S/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/matomo.pid %t/matomo.pod-id
ExecStartPre=/usr/bin/podman pod create --infra-conmon-pidfile %t/matomo.pid \
    --pod-id-file %t/matomo.pod-id \
    --name matomo \
    --network=slirp4netns:allow_host_loopback=true \
    --publish 127.0.0.1:${TCP_PORT}:80 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/matomo.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/matomo.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/matomo.pod-id
PIDFile=%t/matomo.pid
Type=forking

[Install]
WantedBy=default.target