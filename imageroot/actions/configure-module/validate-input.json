{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Configure matomo",
    "$id": "http://nethserver.org/json-schema/task/input/matomo/configure-module",
    "description": "Configure matomo",
    "examples": [
        {
            "host": "matomo.domain.org",
            "http2https": true,
            "lets_encrypt": true
        },
        {
            "host": "matomo.domain.org",
            "http2https": true,
            "lets_encrypt": true,
            "admin_user": "admin",
            "admin_password": "a long secret password",
            "admin_email": "admin@domain.org",
            "site_name": "Example",
            "site_url": "https://www.domain.org",
            "ldap_enabled": true,
            "ldap_view_access": "none",
            "ldap_source": "domain",
            "ldap_domain": "ad.domain.org",
            "ldap_group": "matomo-users"
        }
    ],
    "type": "object",
    "required": [
        "host",
        "http2https",
        "lets_encrypt"
    ],
    "properties": {
        "host": {
            "type": "string",
            "description": "Host name for the application, like 'matomo.domain.org'",
            "format": "hostname",
            "pattern": "\\."
        },
        "lets_encrypt": {
            "type": "boolean",
            "title": "Let's Encrypt certificate",
            "description": "Request a valid Let's Encrypt certificate."
        },
        "http2https": {
            "type": "boolean",
            "title": "HTTP to HTTPS redirection",
            "description": "Redirect all the HTTP requests to HTTPS"
        },
        "admin_user": {
            "type": "string",
            "maxLength": 100,
            "description": "Matomo super user, created on the first configuration only"
        },
        "admin_password": {
            "type": "string",
            "maxLength": 200,
            "description": "Password of the super user (first configuration only, not stored)"
        },
        "admin_email": {
            "type": "string",
            "maxLength": 254
        },
        "site_name": {
            "type": "string",
            "maxLength": 90,
            "description": "First website (first configuration only)"
        },
        "site_url": {
            "type": "string",
            "maxLength": 512,
            "pattern": "^(https?://[^\\s]+)?$"
        },
        "ldap_enabled": {
            "type": "boolean",
            "title": "Login with a user domain or LDAP server"
        },
        "ldap_view_access": {
            "type": "string",
            "enum": [
                "none",
                "all"
            ],
            "description": "View access of a new LDAP user: none, or all websites"
        },
        "ldap_source": {
            "type": "string",
            "enum": [
                "domain",
                "custom"
            ]
        },
        "ldap_domain": {
            "type": "string",
            "maxLength": 253
        },
        "ldap_group": {
            "type": "string",
            "maxLength": 512,
            "description": "Only members of this group may log in (Active Directory)"
        },
        "ldap_url": {
            "type": "string",
            "maxLength": 512
        },
        "ldap_start_tls": {
            "type": "boolean"
        },
        "ldap_tls_verify": {
            "type": "boolean"
        },
        "ldap_schema": {
            "type": "string",
            "enum": [
                "ad",
                "rfc2307"
            ]
        },
        "ldap_base_dn": {
            "type": "string",
            "maxLength": 512
        },
        "ldap_bind_dn": {
            "type": "string",
            "maxLength": 512
        },
        "ldap_bind_password": {
            "type": "string",
            "maxLength": 512,
            "description": "Write only; empty keeps the stored password"
        },
        "ldap_user_attribute": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9-]*$"
        }
    }
}
